# RemasterAgent 配置模板
#
# 用法：复制为同目录下的 .env（已被 .gitignore 忽略），填入真实值。
#       .env 由 Spring Boot 通过 spring.config.import 加载，也可用环境变量覆盖同名键。
#
# 红线：本文件入库，只允许写占位符。任何真实口令 / API Key 一律不得写进来。
# 安全基线提示：不要把 HOST 指向公网 IP、也不要用弱口令（如 123456 / postgres）。
# 默认请保持 127.0.0.1 + 强口令；确需远程连时，用防火墙限来源 IP，而非靠弱密码挡。

# ---------- PostgreSQL 业务库（JSONB 状态树 / checkpoint / 成本明细）----------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=remaster
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__CHANGE_ME__

# 向量表（repo / code_chunk）与业务表同库，无需单独配置；见 docs/ARCHITECTURE.md ADR-11。

# ---------- Redis（Stream 任务队列 + Pub/Sub 进度事件）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=__CHANGE_ME__

# ---------- 大模型（OpenAI 兼容网关）----------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=__CHANGE_ME__
LLM_MODEL=gpt-4o
# 改写节点是高频调用，可单独指一个更便宜的模型；留空则与 LLM_MODEL 相同
LLM_MODEL_REWRITE=
# ---------- 调用韧性（超时 / 重试 / 退避 / 总预算）----------
# 这四项共同决定「一次大模型调用最坏要等多久」，并且只在 LlmRetryExecutor 一处生效 ——
# SDK 内层的 maxRetries 已被显式关闭，否则两层重试会相乘。
# 单次请求超时。设得比网关自身阈值更大没有意义 —— 上游超阈会直接回 524（上游响应超时）。
LLM_TIMEOUT_SECONDS=180
# 失败后最多「再」试几次；2 表示一次调用最多真正发出 3 次请求。嫌慢可降到 1。
LLM_MAX_RETRIES=2
# 重试前的退避基准，指数增长（2s → 4s → 8s …，封顶 30s）。
LLM_RETRY_BACKOFF_MILLIS=2000
# 一次调用（含全部重试）的总时间预算，超出即不再重试。它是「最坏耗时」的硬上限。
LLM_CALL_BUDGET_SECONDS=420
# 成本估算单价（每百万 token）。这里填的是【价目表单价】，不是账单 ——
# llm_call 表记录的是真实 token 用量，金额由这两个值相乘得出。
# 换模型/换网关后必须同步改，否则「每任务成本」这个指标会失真。
LLM_INPUT_PRICE=0
LLM_OUTPUT_PRICE=0

# ---------- 上下文治理（输入侧 token 预算，阶段 5 后续）----------
# 每次改写投喂给模型的「相关代码」上下文 token 上限（按 chars/4 估算）；≤0 回落默认 3000。
# 超过则按 RRF 排名从低优先级开始丢弃，保住要改的源码在 prompt 里的主导地位。
# 默认 3000（≈ 12000 字符，与旧硬编码上限一致，历史行为不变）。
LLM_CONTEXT_MAX_TOKENS=3000
# 治理总开关：false = 检索召回全量透传、不做预算裁剪（排查「是不是上下文被砍」时关它）。
LLM_CONTEXT_ENABLED=true

# ---------- 代码 RAG（阶段 2 理解层）----------
# 代码检索总开关。false = 不索引、不检索，REWRITE 退回「只看目标文件」——
# 这是最省钱的降级开关，排查「是不是检索拖慢了任务」时第一步就该关它。
REMASTER_RAG_ENABLED=true
# 最终喂给模型的块数（上下文预算与召回的折中）
REMASTER_RAG_TOP_K=6
# 每路检索各自取回的候选数：单路取多、融合后取精
REMASTER_RAG_CANDIDATE_K=20
# RRF 公式 1/(k+rank) 里的 k，经典值 60
REMASTER_RAG_RRF_K=60
# 依赖图邻居扩展深度（方法命中后补上它的类骨架）；0 = 关闭
REMASTER_RAG_NEIGHBOR_DEPTH=1

# 向量路用的 embedding 模型。留空 = 向量路禁用，混合检索自动退化为「全文 + 符号」两路。
# 若网关不提供 /embeddings 接口，保持留空 —— 硬配一个不存在的模型会让每次检索都报错。
# 配置时注意维度必须与 code_chunk.embedding 的 vector(1024) 对齐；
# 换模型后先跑一次向量探针核对真实维度，别看文档：
#   mvn.cmd -o -q -pl remaster-agent-tools exec:java \
#     -Dexec.mainClass=com.remasteragent.tools.probe.EmbeddingProbe
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIMENSIONS=

# 向量模型的专用网关与 Key。留空则复用上面的 LLM_BASE_URL / LLM_API_KEY。
# 但两者常常不在一起：chat 走中转网关时，向量往往在云厂商的 MaaS 上（地址与 Key 都不同）。
# 只配一个 LLM_BASE_URL 的话，/embeddings 会打到不提供该接口的 chat 网关上，
# 表现为「检索每次都失败」，且容易被 RAG 的降级逻辑吞掉、看不出真正原因。
# 例（阿里云百炼 MaaS 的 OpenAI 兼容端点）：
#   LLM_EMBEDDING_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_API_KEY=

# ---------- 规划人工评审（阶段 2）----------
# true = PLAN 成功后任务挂到 WAITING_HUMAN，等人在工作台点「批准」再继续执行。
# 批准入口是 API 进程的 POST /api/tasks/{id}/plan/approve，驳回是 .../plan/reject。
# 默认 false：自动执行，端到端行为与阶段 1 一致。
REMASTER_REQUIRE_PLAN_APPROVAL=false

# ---------- 进度订阅链路探活（API 进程）----------
# API 订阅 Pub/Sub 进度事件的那条连接是「只读」的，被 NAT/防火墙静默回收时客户端无从察觉，
# 表现是「快照能到、心跳能到，但增量一条都到不了，页面永远不动」。
# 这里让 API 定期往频道发一条心跳并自行收回，既防连接被回收，也能发现自己已经聋了。
# 只有「连续丢失 3 次心跳」才判死并重建订阅 —— 阈值设太小会让网络抖动引发无谓重建。
REMASTER_PROGRESS_PING_MILLIS=15000
REMASTER_PROGRESS_STALE_MILLIS=45000

# ---------- 本机 Maven 工具链 ----------
# 沙箱执行 mvn test 时会显式使用这三个值，不依赖 PATH（PATH 里的可能是另一个版本）。
# 注意：路径必须用正斜杠。本文件按 properties 语法解析，反斜杠是转义符 ——
# 写成 E:\buildTools 的话 \b 会被解析成退格字符。
MAVEN_HOME=C:/path/to/apache-maven
MAVEN_SETTINGS=C:/path/to/apache-maven/conf/settings.xml
MAVEN_LOCAL_REPO=C:/path/to/maven/repository

# ---------- 沙箱 ----------
# local = 本机受限子进程（无真正隔离，仅用于自有可信工程）
# docker = 容器隔离（需本机装 Docker，阶段后续）
SANDBOX_MODE=local
# 沙箱单次执行的内存上限（MB）与硬超时（秒）
SANDBOX_MEMORY_LIMIT_MB=1024
SANDBOX_TIMEOUT_SECONDS=600

# ---------- 沙箱工作目录 ----------
# 必须是【绝对路径】。相对路径按「进程工作目录」解析 —— 从 AgentServer/、仓库根、各模块目录
# 启动会各留一份 .remaster-workspaces，且同名 task-N 互不相干（本项目实测踩过：分裂出 4 份）。
# 每个任务一个子目录 task-<id>；被测工程只读，改写只落在副本上。
# 【部署到服务器时改这一项】即可，例如 /opt/remaster/workspaces 或 D:/remaster/workspaces。
REMASTER_WORKSPACE_ROOT=C:/path/to/workspaces

# ---------- 沙箱回收 ----------
# 任务到达终态（SUCCEEDED/FAILED）满保留期后，其 task-<id> 目录被【永久删除】（不进回收站）。
# 留窗口期是因为刚结束那一刻最需要现场（看改写结果、查失败原因）；
# 运行中 / 等待人工（WAITING_HUMAN）的任务永不删；数据库重置后遗留的孤儿目录按目录时间判。
# 保留期支持 24h / 30m / 7d / PT24H 写法（默认 24h；配 0 或负数会被当成「没配」回落默认）。
# 排查问题想保留全量沙箱时，把 CLEANUP_ENABLED 置 false。
REMASTER_WORKSPACE_CLEANUP_ENABLED=true
REMASTER_WORKSPACE_RETENTION=24h

# ---------- 运行模式 ----------
# true = Worker 跑在 API 进程内（开发省事）；false = 两个独立进程（架构本来形态）
REMASTER_WORKER_EMBEDDED=true

# ---------- 前端演示预设（仅 AgentVue 读取，可选）----------
# 想启用「一键演示」预设，请在 AgentVue/.env（不入库）里写：
#   VITE_DEMO_ROOT=E:/path/to/remaster-agent
# 注意：Vite 只读取 AgentVue/.env，不读仓库根 .env；此项默认留空即可。
