# RemasterAgent 配置模板
#
# 用法：复制为同目录下的 .env（已被 .gitignore 忽略），填入真实值。
#       .env 由 Spring Boot 通过 spring.config.import 加载，也可用环境变量覆盖同名键。
#
# 红线：本文件入库，只允许写占位符。任何真实口令 / API Key 一律不得写进来。
# 安全基线提示：不要把 HOST 指向公网 IP、也不要用弱口令（如 123456 / postgres）。
# 默认请保持 127.0.0.1 + 强口令；确需远程连时，用防火墙限来源 IP，而非靠弱密码挡。

# ---------- PostgreSQL 业务库（JSONB 状态树 / checkpoint / 成本明细）----------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=remaster
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__CHANGE_ME__

# 向量表（repo / code_chunk）与业务表同库，无需单独配置；见 docs/ARCHITECTURE.md ADR-11。

# ---------- Redis（Stream 任务队列 + Pub/Sub 进度事件）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=__CHANGE_ME__

# ---------- 大模型（OpenAI 兼容网关）----------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=__CHANGE_ME__
LLM_MODEL=gpt-4o
# 改写节点是高频调用，可单独指一个更便宜的模型；留空则与 LLM_MODEL 相同
LLM_MODEL_REWRITE=
# 成本估算单价（每百万 token）。这里填的是【价目表单价】，不是账单 ——
# llm_call 表记录的是真实 token 用量，金额由这两个值相乘得出。
# 换模型/换网关后必须同步改，否则「每任务成本」这个指标会失真。
LLM_INPUT_PRICE=0
LLM_OUTPUT_PRICE=0

# ---------- 本机 Maven 工具链 ----------
# 沙箱执行 mvn test 时会显式使用这三个值，不依赖 PATH（PATH 里的可能是另一个版本）。
# 注意：路径必须用正斜杠。本文件按 properties 语法解析，反斜杠是转义符 ——
# 写成 E:\buildTools 的话 \b 会被解析成退格字符。
MAVEN_HOME=C:/path/to/apache-maven
MAVEN_SETTINGS=C:/path/to/apache-maven/conf/settings.xml
MAVEN_LOCAL_REPO=C:/path/to/maven/repository

# ---------- 沙箱 ----------
# local = 本机受限子进程（无真正隔离，仅用于自有可信工程）
# docker = 容器隔离（需本机装 Docker，阶段后续）
SANDBOX_MODE=local
# 沙箱单次执行的内存上限（MB）与硬超时（秒）
SANDBOX_MEMORY_LIMIT_MB=1024
SANDBOX_TIMEOUT_SECONDS=600

# ---------- 运行模式 ----------
# true = Worker 跑在 API 进程内（开发省事）；false = 两个独立进程（架构本来形态）
REMASTER_WORKER_EMBEDDED=true

# ---------- 前端演示预设（仅 AgentVue 读取，可选）----------
# 想启用「一键演示」预设，请在 AgentVue/.env（不入库）里写：
#   VITE_DEMO_ROOT=E:/path/to/remaster-agent
# 注意：Vite 只读取 AgentVue/.env，不读仓库根 .env；此项默认留空即可。
